# ==========================================================================
# CTF Assistant - environment variables
# Copy this file to ".env.local" for local dev, and set the same keys in the
# Vercel dashboard (Project -> Settings -> Environment Variables) for production.
# NEVER commit the filled-in file. Secrets stay server-side only.
# ==========================================================================

# --- Authentication (NextAuth / Auth.js) --------------------------------
# A random secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# The full URL of the app. Locally: http://localhost:3000  In prod: your Vercel URL
NEXTAUTH_URL=http://localhost:3000

# Single-user gate. Only this email may sign in. Use YOUR login email.
ALLOWED_EMAIL=bravoshivaji@gmail.com

# --- OIDC login provider (pick ONE; Google shown) -----------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Postgres (Vercel Postgres or any Postgres) -------------------------
# Vercel injects POSTGRES_URL automatically when you add Vercel Postgres.
POSTGRES_URL=

# --- Vercel Blob (screenshot storage) -----------------------------------
# Vercel injects this automatically when you add a Blob store.
BLOB_READ_WRITE_TOKEN=

# --- Vision model (reads screenshots) -----------------------------------
# OpenAI-compatible. Base URL + key + model name.
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o

# --- Reasoning model (offensive-security reasoning) ---------------------
# OpenAI-compatible endpoint. This is model-agnostic:
#   - Hosted WhiteRabbitNeo / DeepHat API (simplest to start), OR
#   - Your own self-hosted vLLM server serving WhiteRabbitNeo weights.
# Change these three values to switch providers. No code change needed.
REASON_BASE_URL=
REASON_API_KEY=
REASON_MODEL=WhiteRabbitNeo/WhiteRabbitNeo-V3-7B

# --- GPU lifecycle (only if self-hosting the reasoning model) -----------
# Leave blank when using a hosted reasoning API. When self-hosting on an
# on-demand GPU provider, fill these to let the app start/stop the pod.
GPU_PROVIDER=
GPU_API_KEY=
GPU_POD_ID=

# --- Room memory ---------------------------------------------------------
# After each answer the app extracts new room facts (ports, creds, foothold)
# and merges them into the room's saved state. This costs a small extra
# reasoning call per question. Set to "false" to turn it off and save tokens.
STATE_EXTRACTION_ENABLED=true

# --- Cost estimation (USD per 1M tokens; adjust to your providers) ------
VISION_INPUT_COST_PER_MTOK=2.50
VISION_OUTPUT_COST_PER_MTOK=10.00
REASON_INPUT_COST_PER_MTOK=0.60
REASON_OUTPUT_COST_PER_MTOK=0.80
